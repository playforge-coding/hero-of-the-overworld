CutsceneDef(
    id: "travelersend_intro",
    // Saves from before the American-spelling rename stored this id.
    former_ids: ["travellersend_intro"],
    steps: [
        Say(speaker: Some("ROLAND"), portrait: Some("knight"),
            text: "TRAVELER'S END. THE LAST MOUNTAIN PASS BEFORE THE DEMON FORTRESS."),
        Say(speaker: Some("ELARA"), portrait: Some("mage"),
            text: "CRABS AND SKELETONS ARE THE LEAST OF IT. THE DARK KNIGHTS RIDE THESE HEIGHTS."),
